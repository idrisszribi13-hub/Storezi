-- محرك البحث للـ Field Name
function searchByField(x, f, t, targetVal, freezeVal)
    local fco1, fco2, fco3, fcx1
    if is64 then fco1 = 24 fco2 = 8 fco3 = 16 fcx1 = 32 else fco1 = 12 fco2 = 4 fco3 = 8 fcx1 = 4 end 
