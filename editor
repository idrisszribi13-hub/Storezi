<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>منشئ سكريبتات GameGuardian المتطور</title>
    <style>
        :root {
            --bg-color: #0b0f19;
            --card-bg: #111827;
            --panel-bg: #030712;
            --accent: #0ea5e9;
            --accent-hover: #0284c7;
            --text: #f3f4f6;
            --border: #1f2937;
            --success: #22c55e;
            --danger: #ef4444;
        }
        body {
            font-family: system-ui, -apple-system, sans-serif;
            background-color: var(--bg-color);
            color: var(--text);
            margin: 0;
            padding: 15px;
        }
        .main-layout {
            display: flex;
            gap: 20px;
            max-width: 1400px;
            margin: 0 auto;
        }
        @media (max-width: 900px) {
            .main-layout { flex-direction: column; }
        }
        .control-panel {
            flex: 1;
            background: var(--card-bg);
            padding: 20px;
            border-radius: 12px;
            border: 1px solid var(--border);
            max-height: 90vh;
            overflow-y: auto;
        }
        .output-panel-container {
            flex: 1;
            background: var(--card-bg);
            padding: 20px;
            border-radius: 12px;
            border: 1px solid var(--border);
            display: flex;
            flex-direction: column;
        }
        h1, h2, h3 { color: var(--accent); margin-top: 0; text-align: center; }
        .form-group { margin-bottom: 15px; }
        label { display: block; margin-bottom: 5px; font-weight: bold; font-size: 13px; }
        input, select {
            width: 100%;
            padding: 10px;
            background: var(--panel-bg);
            border: 1px solid var(--border);
            color: var(--text);
            border-radius: 6px;
            box-sizing: border-box;
            font-size: 13px;
        }
        .section-box, .cheat-box {
            background: #1f2937;
            padding: 15px;
            border-radius: 8px;
            border: 1px solid #374151;
            margin-bottom: 15px;
            position: relative;
        }
        .cheat-box { background: #111827; }
        .btn {
            background: var(--accent);
            color: #fff;
            border: none;
            padding: 10px 15px;
            font-weight: bold;
            border-radius: 6px;
            cursor: pointer;
            width: 100%;
            font-size: 14px;
            transition: background 0.2s;
        }
        .btn:hover { background: var(--accent-hover); }
        .btn-secondary { background: #374151; margin-top: 5px; }
        .btn-secondary:hover { background: #4b5563; }
        .btn-danger { background: var(--danger); width: auto; padding: 4px 8px; font-size: 11px; position: absolute; top: 10px; left: 10px; }
        .checkbox-group { display: flex; align-items: center; gap: 8px; margin-top: 8px; }
        .checkbox-group input { width: auto; }
        
        /* تصميم شاشة الـ Terminal المشابهة للصورة */
        .terminal {
            background: var(--panel-bg);
            color: #38bdf8;
            font-family: monospace;
            padding: 15px;
            border-radius: 8px;
            border: 1px solid var(--border);
            flex-grow: 1;
            height: 450px;
            overflow-y: auto;
            white-space: pre-wrap;
            font-size: 12px;
            line-height: 1.5;
        }
        .terminal-header {
            color: #ef4444;
            text-align: center;
            font-weight: bold;
            margin-bottom: 10px;
            border-bottom: 1px solid var(--border);
            padding-bottom: 5px;
        }
    </style>
</head>
<body>

<div class="main-layout">
    <!-- لوحة التحكم وإدخال البيانات -->
    <div class="control-panel">
        <h1>🛠️ منشئ السكريبتات المتقدم</h1>
        
        <div class="form-group">
            <label>عنوان السكريبت العام:</label>
            <input type="text" id="scriptTitle" value="قائمة الهاكات الاحترافية" oninput="updateLivePreview()">
        </div>

        <div class="form-group checkbox-group">
            <input type="checkbox" id="includeSpeedhack" checked onchange="updateLivePreview()">
            <label for="includeSpeedhack" style="margin-bottom:0;">تضمين خاصية السرعة (Speedhack + Slider)</label>
        </div>

        <hr style="border-color: var(--border); margin: 20px 0;">

        <h2>📂 الأقسام والعناوين الرئيسية</h2>
        <div id="sectionsContainer">
            <!-- يتم إضافة الأقسام هنا -->
        </div>

        <button class="btn btn-secondary" onclick="addSection()">➕ إضافة عنوان / قسم جديد للقائمة</button>
        <br><br>
        <button class="btn" onclick="generateAndDownload()">🚀 بدء الإنشاء والتحميل (Build Script)</button>
    </div>

    <!-- لوحة العرض المباشر (Output Panel) -->
    <div class="output-panel-container">
        <div class="terminal-header">[OUTPUT PANEL - LIVE PREVIEW & LOGS]</div>
        <div id="terminalOutput" class="terminal">
            Dumper: ApexEngine | Generator: Ready...
            Waiting for configuration...
        </div>
        <button class="btn btn-secondary" style="margin-top: 10px;" onclick="updateLivePreview()">🔄 تحديث المعاينة الحية</button>
    </div>
</div>

<script>
    window.onload = function() {
        addSection(); // إضافة قسم افتراضي عند الفتح
    };

    function addSection() {
        const container = document.getElementById('sectionsContainer');
        const sIndex = container.children.length + 1;
        
        const div = document.createElement('div');
        div.className = 'section-box';
        div.innerHTML = `
            <button class="btn btn-danger" onclick="this.parentElement.remove(); updateLivePreview();">حذف القسم</button>
            <h3>القسم الرئيسي #${sIndex}</h3>
            <div class="form-group">
                <label>اسم العنوان في القائمة:</label>
                <input type="text" class="s-name" value="قسم اللاعب (Player Hacks)" oninput="updateLivePreview()">
            </div>
            <div class="cheats-list" style="margin-top: 10px;">
                <!-- الميزات التابعة لهذا القسم -->
            </div>
            <button class="btn btn-secondary" style="font-size: 12px; padding: 6px;" onclick="addCheatToSection(this)">➕ إضافة ميزة داخل هذا القسم</button>
        `;
        container.appendChild(div);
        addCheatToSection(div.querySelector('.cheats-list'));
    }

    function addCheatToSection(container) {
        const div = document.createElement('div');
        div.className = 'cheat-box';
        div.innerHTML = `
            <button class="btn btn-danger" style="font-size:10px; padding:2px 6px;" onclick="this.parentElement.remove(); updateLivePreview();">حذف الميزة</button>
            <div class="form-group" style="margin-bottom:8px;">
                <label>اسم الميزة:</label>
                <input type="text" class="c-name" value="طاقة غير محدودة" oninput="updateLivePreview()">
            </div>
            <div class="form-group" style="margin-bottom:8px;">
                <label>طريقة البحث:</label>
                <select class="c-type" onchange="toggleFields(this); updateLivePreview()">
                    <option value="offset">Offset (Class + Offset)</option>
                    <option value="field">Field Name (Class + Name)</option>
                </select>
            </div>
            <div class="form-group" style="margin-bottom:8px;">
                <label>اسم الكلاس (Class Name):</label>
                <input type="text" class="c-class" value="UIStatsController" oninput="updateLivePreview()">
            </div>
            <div class="form-group field-offset-group" style="margin-bottom:8px;">
                <label class="fo-label">الأوفست (Offset):</label>
                <input type="text" class="c-offset" value="0x2C" oninput="updateLivePreview()">
            </div>
            <div class="form-group" style="margin-bottom:8px;">
                <label>نوع البيانات:</label>
                <select class="c-datatype" onchange="updateLivePreview()">
                    <option value="1">1 = Byte / Bool</option>
                    <option value="2">2 = Word</option>
                    <option value="4" selected>4 = Dword</option>
                    <option value="16">16 = Float</option>
                    <option value="32">32 = Double</option>
                </select>
            </div>
            <div class="form-group" style="margin-bottom:8px;">
                <label>القيمة المطلوبة:</label>
                <input type="text" class="c-val" value="999" oninput="updateLivePreview()">
            </div>
            <div class="checkbox-group">
                <input type="checkbox" class="c-freeze" checked onchange="updateLivePreview()">
                <label style="margin-bottom:0;">تجميد القيمة (Freeze)</label>
            </div>
        `;
        container.appendChild(div);
        updateLivePreview();
    }

    function toggleFields(selectElem) {
        const parent = selectElem.closest('.cheat-box');
        const label = parent.querySelector('.fo-label');
        const input = parent.querySelector('.c-offset');
        if(selectElem.value === 'field') {
            label.innerText = "اسم الحقل (Field Name):";
            input.value = "isSelected";
        } else {
            label.innerText = "الأوفست (Offset):";
            input.value = "0x2C";
        }
    }

