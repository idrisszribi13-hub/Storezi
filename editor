    for i, val in ipairs(fbfc) do nfbx[i] = {} nfbx[i].address = val.address + 1 nfbx[i].flags = 1 end
    gg.loadResults(nfbx) gg.searchPointer(0) 
    if gg.getResultsCount() == 0 then gg.alert("لم يتم العثور على المؤشرات!") return end 
    local fpfc = gg.getResults(gg.getResultsCount()) gg.clearResults() local fofc = {}
