                          "⚙️ المعالج: " .. (is64 and "64-bit" or "32-bit") .. "\\n" ..
                          "═══════════════════════════════\\n" ..
                          "اختر القسم أو الوظيفة المطلوبة:"

        local choices = {
`;

        let totalItems = [];
        sections.forEach(sec => {
            const secName = sec.querySelector('.s-name').value;
            choices.push(`"📂 [ " .. "${secName}" .. " ]"`);
            
            const cheats = sec.querySelectorAll('.cheat-box');
            cheats.forEach(c => {
                const cName = c.querySelector('.c-name').value;
                const cType = c.querySelector('.c-type').value;
                const cClass = c.querySelector('.c-class').value;
                const cOffset = c.querySelector('.c-offset').value;
                const cDataType = c.querySelector('.c-datatype').value;
                const cVal = c.querySelector('.c-val').value;
                const cFreeze = c.querySelector('.c-freeze').checked;

                totalItems.push({
                    type: cType,
                    className: cClass,
                    offsetOrField: cOffset,
                    dataType: cDataType,
                    val: cVal,
                    freeze: cFreeze
                });
                choices.push(`"   🔹 " .. "${cName}"`);
            });
        });

        if (includeSpeed) {
            choices.push(`"⚡ تسريع اللعبة (Speed Hack)"`);
        }
        choices.push(`"❌ خروج"`);

        lua += choices.join(",\n") + `\n        }\n\n`;
        lua += `        local choice = gg.choice(choices, nil, menuTitle)\n`;
        lua += `        if choice == nil then os.exit() end\n\n`;

        // ربط الخيارات بمؤشرات التنفيذ الدقيقة
        let currentIndex = 1;
        sections.forEach(sec => {
            // اختيار القسم نفسه (يمكن جعله يعرض تنبيهاً أو يتخطى)
            lua += `        if choice == ${currentIndex} then\n`;
            lua += `            gg.alert("قم باختيار الميزة الفرعية داخل هذا القسم.")\n`;
            lua += `        \n`;
            currentIndex++;

            const cheats = sec.querySelectorAll('.cheat-box');
            cheats.forEach(c => {
                const cType = c.querySelector('.c-type').value;
                const cOffset = c.querySelector('.c-offset').value;
                const cClass = c.querySelector('.c-class').value;
                const cDataType = c.querySelector('.c-datatype').value;
                const cVal = c.querySelector('.c-val').value;
                const cFreeze = c.querySelector('.c-freeze').checked;

                lua += `        elseif choice == ${currentIndex} then\n`;
                if (cType === 'offset') {
                    lua += `            searchByOffset("${cClass}", ${cOffset}, ${cDataType}, ${cVal}, ${cFreeze})\n`;
                } else {
                    lua += `            searchByField("${cClass}", "${cOffset}", ${cDataType}, ${cVal}, ${cFreeze})\n`;
                }
                currentIndex++;
            });
        });

        if (includeSpeed) {
            lua += `        elseif choice == ${currentIndex} then\n`;
            lua += `            speedhackSliderMenu()\n`;
            currentIndex++;
        }

        lua += `        elseif choice == ${currentIndex} then\n`;
        lua += `            gg.setVisible(true)\n`;
        lua += `            os.exit()\n`;
        lua += `        end\n`;
        lua += `    end\n`;
        lua += `end\n\n`;
        lua += `main()\n`;

        return lua;
    }

    function updateLivePreview() {
        const terminal = document.getElementById('terminalOutput');
        const code = buildLuaCode();
        terminal.innerText = code;
    }

    function generateAndDownload() {
        const terminal = document.getElementById('terminalOutput');
        terminal.innerText = "[*] Initializing generator engine...\n[*] Parsing sections and categories...\n[*] Injecting core GameGuardian search signatures...\n[*] Compiling Lua bytecode structure...\n";
        
        setTimeout(() => {
            terminal.innerText += "[*] Verifying memory boundaries and pointer offsets...\n";
        }, 400);

        setTimeout(() => {
            terminal.innerText += "[*] Building interactive menu loop...\n";
            const code = buildLuaCode();
            
            setTimeout(() => {
                terminal.innerText += "[+] Task Completed Successfully!\n[+] Lua script generated and download started automatically.";
                
                // تحميل الملف
                const blob = new Blob([code], { type: 'text/plain;charset=utf-8' });
                const link = document.createElement('a');
                link.href = URL.createObjectURL(blob);
                link.download = 'Advanced_GameGuardian_Script.lua';
                link.click();
            }, 600);
        }, 800);
    }
</script>

